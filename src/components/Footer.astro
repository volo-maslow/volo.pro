---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer" data-scene-avoid>
  <p>© {year} {site.name.toLowerCase()}</p>
  <p>set in plex mono &amp; newsreader</p>
  <p>static html · no cookies · no tracking</p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 128px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--tiny);
    letter-spacing: 0.01em;
  }
</style>
