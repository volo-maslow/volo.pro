---
/**
 * Shell.astro: the whole HTML document for the "instrument" lab direction.
 * Own head, own fonts, own tokens; does not use layouts/Base.astro.
 */
import geist400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import geist500 from '@fontsource/geist-mono/files/geist-mono-latin-500-normal.woff2?url';
import doto from '@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url';
import './instrument.css';
import DotTree from '../../components/tree/DotTree.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { site } from '../../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Home gets the full tree; inner pages a quieter one. */
  fullTree?: boolean;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  fullTree = false,
} = Astro.props;

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontCss = [
  `@font-face{font-family:'Geist Mono';font-style:normal;font-weight:400;font-display:block;src:url(${geist400}) format('woff2');unicode-range:${latin}}`,
  `@font-face{font-family:'Geist Mono';font-style:normal;font-weight:500;font-display:block;src:url(${geist500}) format('woff2');unicode-range:${latin}}`,
  `@font-face{font-family:'Doto';font-style:normal;font-weight:100 900;font-display:block;src:url(${doto}) format('woff2');unicode-range:${latin}}`,
].join('');

const siteName = site.name.toLowerCase();
const fullTitle = title ? `${title} · ${siteName}` : siteName;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[geist400, geist500, doto].map((url) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontCss} />
    <script is:inline>
      // Render gate: hide the content (not the tree) until all three faces are
      // ready, so nothing paints in a fallback. No JS, no class, no gate.
      (function () {
        var root = document.documentElement;
        var fonts = document.fonts;
        if (!fonts || !fonts.load) return;
        root.classList.add('fonts-loading');
        var done = function () {
          root.classList.remove('fonts-loading');
        };
        Promise.all([
          fonts.load('400 14px "Geist Mono"'),
          fonts.load('500 14px "Geist Mono"'),
          fonts.load('700 64px "Doto"'),
        ]).then(done, done);
        setTimeout(done, 900);
        addEventListener('pageshow', function (e) {
          if (e.persisted) done();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="noindex" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    <meta
      name="theme-color"
      content="#f3eee4"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14110e"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <DotTree class={fullTree ? undefined : 'dot-tree--quiet'} />
    <div class="shell">
      <Nav />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .shell {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    max-width: calc(var(--column) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 28px var(--gutter) 40px;
  }

  /* Tree root sits at 0.76·vw: shift the column left so the crown reads in the right margin. */
  @media (min-width: 1024px) {
    .shell {
      margin-left: max(
        0px,
        calc((100vw - var(--column) - 2 * var(--gutter) - var(--tree-lane)) / 2)
      );
      margin-right: auto;
    }
  }

  main {
    flex: 1;
  }

  :global(.dot-tree--quiet) {
    opacity: 0.55;
  }
</style>
