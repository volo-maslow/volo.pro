---
const items = [
  { key: 'h', label: 'index', href: '/lab/instrument/' },
  { key: 'w', label: 'writing', href: '/writing' },
  { key: 'p', label: 'projects', href: '/projects' },
  { key: 'n', label: 'now', href: '/now' },
] as const;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string): boolean =>
  path === href.replace(/\/$/, '');
---

<header class="bar" data-tree-avoid>
  <nav aria-label="primary">
    <ul>
      {items.map(({ key, label, href }) => (
        <li>
          <a
            href={href}
            data-shortcut={key}
            aria-keyshortcuts={key}
            aria-current={isCurrent(href) ? 'page' : undefined}
          >
            <kbd class="key" aria-hidden="true">{key}</kbd>
            <span>{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="clock tnum" data-clock hidden>
    <span>hamburg</span>
    <time data-clock-time></time>
  </p>
</header>

<script is:inline>
  // Global single-key shortcuts: h index, w writing, p projects, n now.
  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.repeat) return;
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    const t = e.target;
    if (
      t instanceof HTMLElement &&
      (t.isContentEditable || t.closest('input, textarea, select'))
    )
      return;
    const link = document.querySelector(
      'a[data-shortcut="' + e.key.toLowerCase() + '"]',
    );
    if (!(link instanceof HTMLAnchorElement) || e.key.length !== 1) return;
    e.preventDefault();
    const cap = link.querySelector('.key');
    if (cap) cap.setAttribute('data-pressed', '');
    window.location.assign(link.href);
  });

  // Local time in Hamburg, the one live readout on the bar.
  (function () {
    const host = document.querySelector('[data-clock]');
    const out = host && host.querySelector('[data-clock-time]');
    if (!host || !out) return;
    const fmt = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Berlin',
      timeZoneName: 'short',
    });
    const tick = () => {
      const parts = fmt.formatToParts(new Date());
      const get = (t) => (parts.find((p) => p.type === t) || {}).value || '';
      out.textContent =
        get('hour') + ':' + get('minute') + ' ' + get('timeZoneName').toLowerCase();
    };
    tick();
    host.hidden = false;
    setInterval(tick, 15000);
  })();
</script>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: var(--fs-sm);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    text-decoration: none;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--ink);
  }

  a:hover .key,
  a:focus-visible .key {
    color: var(--ink);
    border-color: var(--ink);
  }

  a[aria-current='page'] .key {
    border-color: var(--ink);
    color: var(--ink);
  }

  .key[data-pressed] {
    transform: translateY(1px);
    border-bottom-width: 1px;
  }

  .clock {
    display: flex;
    gap: 10px;
    color: var(--muted);
  }

  .clock[hidden] {
    display: none;
  }

  .clock time {
    color: var(--text);
  }

  @media (max-width: 639px) {
    .key {
      display: none;
    }
  }
</style>
