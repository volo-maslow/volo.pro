---
import { site } from '../../data/site';
import { elsewhere } from '../../data/elsewhere';

const shown = ['email', 'github', 'rss'];
const links = elsewhere.filter((l) => shown.includes(l.label));
const year = new Date().getFullYear();
---

<footer class="foot" data-tree-avoid>
  <p>© {year} {site.name.toLowerCase()}, hamburg</p>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href}>{l.label}</a>
      </li>
    ))}
  </ul>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin-top: 112px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--fs-xs);
    letter-spacing: 0.01em;
  }

  ul {
    display: flex;
    gap: 20px;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }
</style>
