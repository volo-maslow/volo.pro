---
/**
 * apothecary — full standalone document for the lab direction.
 * Parchment and brown-black ink, mono first, one serif voice for display moments.
 */
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex400i from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-italic.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import DotTree from '../../components/tree/DotTree.astro';
import { site } from '../../data/site';
import './theme.css';

interface Props {
  title?: string;
  description?: string;
  /** Path shown in the masthead, after "volo.pro". */
  crumbs: { label: string; href?: string }[];
  /** Home gets the full tree; the article a quieter one. */
  quietTree?: boolean;
}

const {
  title,
  description = site.description,
  crumbs,
  quietTree = false,
} = Astro.props;

const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const faces = [
  { family: 'IBM Plex Mono', style: 'normal', weight: '400', url: plex400 },
  { family: 'IBM Plex Mono', style: 'italic', weight: '400', url: plex400i },
  { family: 'IBM Plex Mono', style: 'normal', weight: '500', url: plex500 },
  { family: 'Newsreader', style: 'normal', weight: '200 800', url: newsreader },
];
const fontFaceCss = faces
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:${f.style};font-weight:${f.weight};font-display:block;src:url(${f.url}) format('woff2');unicode-range:${latinRange}}`,
  )
  .join('');

const siteName = site.name.toLowerCase();
const fullTitle = title ? `${title} · ${siteName}` : siteName;

const nav = [
  { key: 'h', label: 'home', href: '/lab/apothecary/' },
  { key: 'w', label: 'writing', href: '/writing' },
  { key: 'p', label: 'projects', href: '/projects' },
  { key: 'n', label: 'now', href: '/now' },
] as const;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faces.map((f) => (
      <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline>
      // Render gate: the page waits for its faces (the tree does not).
      (function () {
        var root = document.documentElement;
        var fonts = document.fonts;
        if (!fonts || !fonts.load) return;
        root.classList.add('fonts-loading');
        var done = function () {
          root.classList.remove('fonts-loading');
        };
        Promise.all([
          fonts.load('400 15px "IBM Plex Mono"'),
          fonts.load('italic 400 15px "IBM Plex Mono"'),
          fonts.load('500 15px "IBM Plex Mono"'),
          fonts.load('300 40px "Newsreader"'),
        ]).then(done, done);
        setTimeout(done, 800);
        addEventListener('pageshow', function (e) {
          if (e.persisted) done();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f6f5e8"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#17110b"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="ap-skip" href="#main">skip to content</a>
    <DotTree class={quietTree ? 'ap-tree ap-tree--quiet' : 'ap-tree'} />
    <div class="ap-page">
      <header class="ap-mast" data-tree-avoid>
        <p class="ap-crumbs">
          <a href="/lab/apothecary/">volo.pro</a>
          {crumbs.map((c) => (
            <>
              <span class="ap-slash" aria-hidden="true">/</span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </p>
        <nav aria-label="primary">
          <ul>
            {nav.map(({ key, label, href }) => (
              <li>
                <a
                  href={href}
                  data-shortcut={key}
                  aria-keyshortcuts={key}
                  aria-current={href.replace(/\/$/, '') === path ? 'page' : undefined}
                >
                  <span class="ap-key" aria-hidden="true">{key}</span>
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="ap-foot" data-tree-avoid>
        <p>© {year} {siteName}</p>
        <p>set in plex mono &amp; newsreader</p>
        <p>static html · no cookies · no tracking</p>
      </footer>
    </div>

    <script is:inline>
      // Single-key shortcuts: h home, w writing, p projects, n now.
      document.addEventListener('keydown', function (e) {
        if (e.defaultPrevented || e.repeat) return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        var t = e.target;
        if (
          t instanceof HTMLElement &&
          (t.isContentEditable || t.closest('input, textarea, select'))
        )
          return;
        if (e.key.length !== 1) return;
        var link = document.querySelector(
          'a[data-shortcut="' + e.key.toLowerCase() + '"]',
        );
        if (!(link instanceof HTMLAnchorElement)) return;
        e.preventDefault();
        window.location.assign(link.href);
      });
    </script>
  </body>
</html>
