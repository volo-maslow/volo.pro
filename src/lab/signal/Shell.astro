---
/**
 * Shell.astro (lab / signal): full HTML document for the "signal" direction.
 * Own head, fonts, render gate, tree host, keycap nav and footer.
 */
import geist400 from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import geist500 from '@fontsource/geist-mono/files/geist-mono-latin-500-normal.woff2?url';
import doto from '@fontsource-variable/doto/files/doto-latin-full-normal.woff2?url';
import './signal.css';
import DotTree from '../../components/tree/DotTree.astro';
import { site } from '../../data/site';
import { elsewhere } from '../../data/elsewhere';

type Key = 'h' | 'w' | 'p' | 'n';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  fullTree?: boolean;
  /** Which nav key is lit. */
  current?: Key;
}

const {
  title,
  description = site.description,
  type = 'website',
  fullTree = false,
  current,
} = Astro.props;

const HOME = '/lab/signal';
const POST = '/lab/signal/post';

const nav: { key: Key; label: string; href: string }[] = [
  { key: 'h', label: 'home', href: HOME },
  { key: 'w', label: 'writing', href: '/writing' },
  { key: 'p', label: 'projects', href: '/projects' },
  { key: 'n', label: 'now', href: '/now' },
];

const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaceCss = [
  `@font-face{font-family:'Geist Mono Signal';font-style:normal;font-weight:400;font-display:block;src:url(${geist400}) format('woff2');unicode-range:${latinRange}}`,
  `@font-face{font-family:'Geist Mono Signal';font-style:normal;font-weight:500;font-display:block;src:url(${geist500}) format('woff2');unicode-range:${latinRange}}`,
  `@font-face{font-family:'Doto Signal';font-style:normal;font-weight:100 900;font-display:block;src:url(${doto}) format('woff2');unicode-range:${latinRange}}`,
].join('');

const siteName = site.name.toLowerCase();
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const footerLinks = elsewhere.filter((l) => l.label !== 'arctype');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[geist400, geist500, doto].map((url) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline>
      // Render gate: hide the content (not the tree) until Geist Mono and Doto
      // are ready, so nothing paints in a fallback face. No JS, no gate.
      (function () {
        var root = document.documentElement;
        var fonts = document.fonts;
        if (!fonts || !fonts.load) return;
        root.classList.add('fonts-loading');
        var done = function () {
          root.classList.remove('fonts-loading');
        };
        Promise.all([
          fonts.load('400 15px "Geist Mono Signal"'),
          fonts.load('500 15px "Geist Mono Signal"'),
          fonts.load('700 15px "Doto Signal"'),
        ]).then(done, done);
        setTimeout(done, 800);
        addEventListener('pageshow', function (e) {
          if (e.persisted) done();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content="noindex" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#efefec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='9' fill='%23d1161f'/%3E%3C/svg%3E"
    />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} · writing`} href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <DotTree class={fullTree ? undefined : 'signal-tree--quiet'} />
    <div class="page">
      <header class="bar" data-tree-avoid>
        <a class="mark micro" href={HOME} aria-label={`${siteName}, home`}>
          volo.pro
        </a>
        <nav aria-label="primary">
          <ul>
            {nav.map(({ key, label, href }) => (
              <li>
                <a
                  href={href}
                  data-shortcut={key}
                  aria-keyshortcuts={key}
                  aria-current={current === key ? 'page' : undefined}
                >
                  <span class="key" aria-hidden="true">{key}</span>
                  <span class="label">{label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="foot" data-tree-avoid>
        <span class="dots" aria-hidden="true"></span>
        <div class="foot-row">
          <p class="micro">
            © <span class="num">{year}</span> {siteName}
          </p>
          <ul class="foot-links micro">
            {footerLinks.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
            <li>
              <a href={POST}>colophon</a>
            </li>
          </ul>
        </div>
      </footer>
    </div>

    <script is:inline>
      // Global single-key shortcuts: h home, w writing, p projects, n now.
      document.addEventListener('keydown', function (e) {
        if (e.defaultPrevented || e.repeat) return;
        if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
        var t = e.target;
        if (
          t instanceof HTMLElement &&
          (t.isContentEditable || t.closest('input, textarea, select'))
        )
          return;
        if (e.key.length !== 1) return;
        var link = document.querySelector(
          'a[data-shortcut="' + e.key.toLowerCase() + '"]',
        );
        if (!(link instanceof HTMLAnchorElement)) return;
        e.preventDefault();
        link.classList.add('is-pressed');
        window.location.assign(link.href);
      });
    </script>
  </body>
</html>

<style>
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }

  .mark {
    color: var(--ink);
  }

  .mark:hover {
    color: var(--signal);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a:hover .key {
    border-color: var(--signal);
    color: var(--signal);
  }

  nav a[aria-current='page'] .key,
  nav a.is-pressed .key {
    border-color: var(--signal);
    background: var(--signal);
    color: var(--on-signal);
  }

  nav a.is-pressed .key {
    border-bottom-width: 1px;
    transform: translateY(1px);
  }

  .foot {
    margin-top: 120px;
  }

  .foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 18px;
  }

  .foot .num {
    font-size: 13px;
    letter-spacing: 0.06em;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    padding: 0;
    list-style: none;
  }

  .foot-links a:hover {
    color: var(--signal);
  }

  @media (max-width: 479px) {
    .mark {
      display: none;
    }

    nav ul {
      gap: 6px 12px;
    }

    nav a {
      gap: 6px;
      letter-spacing: 0.08em;
    }
  }
</style>
