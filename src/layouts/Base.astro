---
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import plex600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import DotTree from '../components/tree/DotTree.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title; the site name is appended unless this is the home page. */
  title?: string;
  description?: string;
  /** og:type, "article" for posts. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  /** Home page gets the full tree; inner pages a quieter one. */
  fullTree?: boolean;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  noindex = false,
  fullTree = false,
} = Astro.props;

/*
 * IBM Plex Mono, latin subset, only the weights the CSS uses. Declared here
 * (not via @fontsource CSS) so the preload hrefs and the @font-face srcs are
 * the same hashed URLs. font-display: block, plus the fonts-loading gate
 * below, means text never paints in the fallback face.
 */
const fontFaces = [
  [400, plex400],
  [500, plex500],
  [600, plex600],
] as const;
const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaceCss = fontFaces
  .map(
    ([weight, url]) =>
      `@font-face{font-family:'IBM Plex Mono';font-style:normal;font-weight:${weight};font-display:block;src:url(${url}) format('woff2');unicode-range:${latinRange}}`,
  )
  .join('');

const siteName = site.name.toLowerCase();
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fontFaces.map(([, url]) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline>
      // Render gate: hide the content wrapper (not the tree) until the faces
      // are ready, so text never paints in a fallback font. Without JS the
      // class is never added. Cached fonts resolve immediately.
      (function () {
        var root = document.documentElement;
        var fonts = document.fonts;
        if (!fonts || !fonts.load) return;
        root.classList.add('fonts-loading');
        var done = function () {
          root.classList.remove('fonts-loading');
        };
        var family = ' 15px "IBM Plex Mono"';
        Promise.all(
          ['400', '500', '600'].map(function (w) {
            return fonts.load(w + family);
          }),
        ).then(done, done);
        setTimeout(done, 800);
        // bfcache restore: never come back hidden.
        addEventListener('pageshow', function (e) {
          if (e.persisted) done();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary" />
    <meta
      name="theme-color"
      content="#f5f4f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#141312"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} · writing`}
      href={new URL('/rss.xml', Astro.site ?? site.url).href}
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      skip to content
    </a>
    <DotTree class={fullTree ? undefined : 'dot-tree--quiet'} />
    <div class="page">
      <Nav />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    max-width: calc(var(--column) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 48px var(--gutter);
  }

  /*
   * Wide screens: the tree root sits at 0.76·vw (tree/layout.ts) and its crown
   * spans roughly ±0.27·H around it. Centre column + tree lane as one group, so
   * the column moves left of centre and the crown reads through the right margin.
   */
  @media (min-width: 1024px) {
    .page {
      margin-left: max(
        0px,
        calc((100vw - var(--column) - 2 * var(--gutter) - var(--tree-lane)) / 2)
      );
      margin-right: auto;
    }
  }

  main {
    flex: 1;
    padding-top: 56px;
  }

  /* Inner pages: same tree, quieter. The runtime fades the canvas, not the host. */
  :global(.dot-tree--quiet) {
    opacity: 0.6;
  }
</style>
