---
import plex400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plex400i from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-italic.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
/*
 * Background scene: the one place to swap it. Any component that takes a
 * `class` prop, renders a fixed full-viewport host with pointer-events: none,
 * reads `--scene-ink` and honours `data-scene-avoid` fits here. The quiet
 * look on inner pages is `.backdrop--quiet` (global.css), so it applies to
 * any scene. The previous scene, components/tree/DotTree.astro, reads the
 * same names (tree/runtime.ts readInk and measureAvoid), so swapping the
 * import back is enough; the lane is page CSS and needs nothing from it.
 */
import Backdrop from '../components/waterfall/Waterfall.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title; the site name is appended unless this is the home page. */
  title?: string;
  description?: string;
  /** og:type, "article" for posts. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  /** Home page gets the full scene; inner pages a quieter one. */
  fullScene?: boolean;
  /** Path shown in the masthead after "volo.pro"; the last crumb is the current page. */
  crumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  noindex = false,
  fullScene = false,
  crumbs = [],
} = Astro.props;

/*
 * Faces, latin subset, only what the CSS uses: IBM Plex Mono 400 / 400 italic /
 * 500 for everything, Newsreader (variable, opsz) at 300 for the home statement
 * and post titles. Declared here (not via @fontsource CSS) so the preload hrefs
 * and the @font-face srcs are the same hashed URLs. font-display: block, plus
 * the fonts-loading gate below, means text never paints in a fallback face.
 */
const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const faces = [
  { family: 'IBM Plex Mono', style: 'normal', weight: '400', url: plex400 },
  { family: 'IBM Plex Mono', style: 'italic', weight: '400', url: plex400i },
  { family: 'IBM Plex Mono', style: 'normal', weight: '500', url: plex500 },
  { family: 'Newsreader', style: 'normal', weight: '200 800', url: newsreader },
];
const fontFaceCss = faces
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:${f.style};font-weight:${f.weight};font-display:block;src:url(${f.url}) format('woff2');unicode-range:${latinRange}}`,
  )
  .join('');

const siteName = site.name.toLowerCase();
const fullTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faces.map((f) => (
      <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss} />
    <script is:inline>
      // Render gate: hide the content wrapper (not the background) until the
      // faces are ready, so text never paints in a fallback font. Without JS
      // the class is never added. Cached fonts resolve immediately.
      (function () {
        var root = document.documentElement;
        var fonts = document.fonts;
        if (!fonts || !fonts.load) return;
        root.classList.add('fonts-loading');
        var done = function () {
          root.classList.remove('fonts-loading');
        };
        Promise.all([
          fonts.load('400 15px "IBM Plex Mono"'),
          fonts.load('italic 400 15px "IBM Plex Mono"'),
          fonts.load('500 15px "IBM Plex Mono"'),
          fonts.load('300 40px "Newsreader"'),
        ]).then(done, done);
        setTimeout(done, 800);
        // bfcache restore: never come back hidden.
        addEventListener('pageshow', function (e) {
          if (e.persisted) done();
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && (
      <meta
        property="article:published_time"
        content={publishedTime.toISOString()}
      />
    )}
    <meta name="twitter:card" content="summary" />
    <meta
      name="theme-color"
      content="#f6f5e8"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#17110b"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} · writing`}
      href={new URL('/rss.xml', Astro.site ?? site.url).href}
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <Backdrop
      class={fullScene ? 'backdrop' : 'backdrop backdrop--quiet dot-waterfall--quiet'}
    />
    <div class="page">
      <Nav crumbs={crumbs} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
