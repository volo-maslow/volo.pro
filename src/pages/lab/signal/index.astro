---
import Shell from '../../../lab/signal/Shell.astro';
import Num from '../../../lab/signal/Num.astro';
import { dotDate, dotMonth, pad2 } from '../../../lab/signal/format';
import { site } from '../../../data/site';
import { work } from '../../../data/work';
import { projects } from '../../../data/projects';
import { elsewhere } from '../../../data/elsewhere';
import { getPosts } from '../../../lib/posts';

const posts = (await getPosts()).slice(0, 4);
const roles = work.slice(0, 3);
const current = work.filter((r) => !r.end && r.start);
const shown = projects.slice(0, 3);
const [first, last] = [
  site.name.split(' ')[0] ?? site.name,
  site.name.split(' ').slice(1).join(' '),
];

/** The colophon has a lab rendering; other posts link to the live site. */
const postHref = (id: string): string =>
  id === 'colophon' ? '/lab/signal/post' : `/writing/${id}`;
---

<Shell fullTree current="h">
  <section class="hero" aria-labelledby="name">
    <h1 id="name" class="name num" data-tree-avoid>
      <span>{first}</span>
      <span>{last}</span>
    </h1>
    <p class="tagline micro" data-tree-avoid>{site.tagline}</p>
    <p class="bio" data-tree-avoid>{site.bio.join(' ')}</p>
  </section>

  <section class="widgets" aria-label="status" data-tree-avoid>
    {current.map((r, i) => (
      <a class="widget module" href={r.url}>
        <span class="w-top">
          <span class="micro">now · {pad2(i + 1)}</span>
          <span class="w-arrow" aria-hidden="true">↗</span>
        </span>
        <span class="w-body">
          <span class="w-value">{r.company}</span>
          <span class="w-sub">
            {r.title}
            <span class="w-since">
              since <Num class="since" value={dotMonth(r.start)} />
            </span>
          </span>
        </span>
      </a>
    ))}
    <div class="widget module clock" role="group" aria-label="local time in hamburg">
      <span class="w-top">
        <span class="micro">hamburg</span>
        <span class="led" aria-hidden="true"></span>
      </span>
      <span class="w-body">
        <time class="clock-time num" data-clock>
          <span data-h>--</span><span class="sep sep--colon colon"><span class="sep-text">:</span></span><span data-m>--</span>
        </time>
        <span class="w-sub micro" data-zone>europe/berlin</span>
      </span>
    </div>
  </section>

  <section class="sec" aria-labelledby="writing">
    <div class="sec-head">
      <h2 id="writing"><span class="idx num" aria-hidden="true">01</span>writing</h2>
      <span class="dots" aria-hidden="true"></span>
      <a class="more micro" href="/writing">all <span aria-hidden="true">↗</span></a>
    </div>
    {posts.length === 0 ? (
      <p class="empty" data-tree-avoid>nothing here yet.</p>
    ) : (
      <ul class="rows" data-tree-avoid>
        {posts.map((p) => (
          <li>
            <a class="row post" href={postHref(p.id)}>
              <time datetime={dotDate(p.data.date).replaceAll('.', '-')}>
                <Num class="date" value={dotDate(p.data.date)} />
              </time>
              <span class="row-main">
                <span class="row-title">
                  {p.data.title.toLowerCase()}
                  {p.data.draft && <span class="tag micro">draft</span>}
                </span>
                <span class="row-desc">{p.data.description}</span>
              </span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="sec" aria-labelledby="work">
    <div class="sec-head">
      <h2 id="work"><span class="idx num" aria-hidden="true">02</span>work</h2>
      <span class="dots" aria-hidden="true"></span>
      <a class="more micro" href="/work">all <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="rows" data-tree-avoid>
      {roles.map((r) => (
        <li class="row role">
          <span class="span">
            {r.start ? (
              <>
                <Num class="date" value={dotMonth(r.start)} />
                <span class="span-to micro">
                  {r.end ? <>→ <Num class="date" value={dotMonth(r.end)} /></> : '→ now'}
                </span>
              </>
            ) : r.end ? (
              <>
                <span class="span-to micro">until</span>
                <Num class="date" value={dotMonth(r.end)} />
              </>
            ) : (
              <span class="span-to micro">earlier</span>
            )}
          </span>
          <span class="row-main">
            <span class="row-title">
              {r.url ? (
                <a href={r.url}>
                  {r.company}
                  <span aria-hidden="true"> ↗</span>
                </a>
              ) : (
                r.company
              )}
              <span class="role-title micro">{r.title}</span>
            </span>
            <span class="row-desc">{r.summary}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" aria-labelledby="projects">
    <div class="sec-head">
      <h2 id="projects"><span class="idx num" aria-hidden="true">03</span>projects</h2>
      <span class="dots" aria-hidden="true"></span>
      <a class="more micro" href="/projects">all <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="cards" data-tree-avoid>
      {shown.map((p, i) => (
        <li class="card module">
          <span class="w-top">
            <Num class="card-idx" value={`P.${pad2(i + 1)}`} />
            <span class="micro">{p.role}</span>
          </span>
          <h3 class="card-name">
            {p.url ? (
              <a href={p.url}>
                {p.name}
                <span class="w-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              p.name
            )}
          </h3>
          <p class="card-sum">{p.summary}</p>
          <p class="card-foot">
            <span class="micro">{p.tech.join(' / ')}</span>
            <span class="num">{p.date}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" aria-labelledby="elsewhere">
    <div class="sec-head">
      <h2 id="elsewhere"><span class="idx num" aria-hidden="true">04</span>elsewhere</h2>
      <span class="dots" aria-hidden="true"></span>
    </div>
    <dl class="spec" data-tree-avoid>
      {elsewhere.map((l) => (
        <div>
          <dt class="micro">{l.label}</dt>
          <dd>
            <a href={l.href}>
              {l.detail ?? l.href}
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</Shell>

<script>
  // Hamburg clock for the status widget. Minute resolution, re-aligned to the minute.
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const h = el.querySelector<HTMLElement>('[data-h]');
    const m = el.querySelector<HTMLElement>('[data-m]');
    const zone = document.querySelector<HTMLElement>('[data-zone]');
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Berlin',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
      timeZoneName: 'short',
    });
    const tick = (): void => {
      const now = new Date();
      const parts = fmt.formatToParts(now);
      const get = (t: string): string =>
        parts.find((p) => p.type === t)?.value ?? '';
      if (h) h.textContent = get('hour');
      if (m) m.textContent = get('minute');
      if (zone) zone.textContent = `europe/berlin · ${get('timeZoneName')}`;
      el.setAttribute('datetime', `${get('hour')}:${get('minute')}`);
      setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
    };
    tick();
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    padding-top: 112px;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.42em;
    margin-left: -0.04em;
    color: var(--ink);
    font-size: clamp(64px, 17vw, 112px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .tagline {
    margin-top: 28px;
    color: var(--ink);
  }

  .bio {
    max-width: 54ch;
    margin-top: 18px;
    color: var(--text);
    font-size: 15px;
    line-height: 1.75;
    text-wrap: pretty;
  }

  /* ---------- widgets ---------- */
  .widgets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 56px;
  }

  .widget {
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-height: 152px;
    padding: 16px 18px 18px;
    color: var(--ink);
    transition: border-color var(--ease);
  }

  a.widget:hover {
    border-color: var(--line-strong);
  }

  a.widget:hover .w-arrow {
    color: var(--signal);
  }

  .w-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .w-arrow {
    color: var(--muted);
    font-size: 13px;
    transition: color var(--ease);
  }

  .w-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .w-value {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .w-sub {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.45;
  }

  .w-since .num {
    color: var(--text);
    font-size: 15px;
  }

  .clock-time {
    display: block;
    flex: none;
    white-space: nowrap;
    font-size: 48px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 0.9;
  }

  .colon {
    animation: led 2s steps(1, end) infinite;
  }

  /* ---------- rows ---------- */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .rows > li {
    border-bottom: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) 24px;
    gap: 0 24px;
    align-items: baseline;
    padding: 16px 0;
  }

  .role {
    grid-template-columns: 120px minmax(0, 1fr);
  }

  .row .num,
  .span .num {
    color: var(--ink);
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .row-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    color: var(--ink);
    font-weight: 500;
  }

  .row-title a:hover,
  .post:hover .row-title {
    color: var(--signal);
  }

  .row-desc {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .row-arrow {
    justify-self: end;
    color: var(--muted);
    transition:
      color var(--ease),
      transform var(--ease);
  }

  .post:hover .row-arrow,
  .spec a:hover .row-arrow {
    color: var(--signal);
    transform: translateX(3px);
  }

  .tag {
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    font-size: 9.5px;
  }

  .span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .span-to {
    font-size: 10.5px;
  }

  .role-title {
    font-weight: 500;
  }

  .empty {
    color: var(--muted);
  }

  /* ---------- project cards ---------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 236px;
    padding: 16px 18px 16px;
    transition: border-color var(--ease);
  }

  .card:has(a:hover) {
    border-color: var(--line-strong);
  }

  .card-idx {
    color: var(--ink);
    font-size: 15px;
  }

  .card-name {
    margin-top: 40px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .card-name .w-arrow {
    margin-left: 6px;
  }

  /* Whole card is the hit area. */
  .card-name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-name a:hover .w-arrow {
    color: var(--signal);
  }

  .card-sum {
    margin-top: 8px;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.6;
  }

  .card-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 18px;
  }

  .card-foot .micro {
    font-size: 9.5px;
  }

  .card-foot .num {
    color: var(--ink);
    font-size: 14px;
  }

  /* ---------- spec list ---------- */
  .spec {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .spec > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 0 24px;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
  }

  .spec dt {
    padding: 13px 0;
  }

  .spec dd {
    margin: 0;
  }

  .spec a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    color: var(--ink);
  }

  .spec a:hover {
    color: var(--signal);
  }

  /* ---------- small screens ---------- */
  @media (max-width: 719px) {
    .hero {
      padding-top: 72px;
    }

    .name {
      flex-direction: column;
    }

    .widgets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .widget {
      gap: 32px;
      padding: 14px 16px 16px;
    }

    .clock {
      grid-column: 1 / -1;
      min-height: 0;
    }

    .clock .w-body {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
    }

    .cards {
      grid-template-columns: 1fr;
    }

    .card {
      min-height: 0;
    }

    .card-name {
      margin-top: 24px;
    }

    .sec {
      margin-top: 72px;
    }
  }

  @media (max-width: 479px) {
    .row,
    .role,
    .spec > div {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .row:not(.role) {
      grid-template-columns: minmax(0, 1fr) 24px;
    }

    .row time {
      grid-column: 1 / -1;
    }

    .role .span {
      flex-direction: row;
      align-items: baseline;
      gap: 10px;
    }

    .spec dt {
      padding: 13px 0 0;
    }

    .spec a {
      padding-top: 0;
    }
  }
</style>
