---
import { getEntry, render } from 'astro:content';
import Shell from '../../../lab/signal/Shell.astro';
import Num from '../../../lab/signal/Num.astro';
import { dotDate, pad2 } from '../../../lab/signal/format';
import { readingTime } from '../../../lib/readingTime';

const post = await getEntry('writing', 'colophon');
if (!post) throw new Error('lab/signal: colophon post not found');
const { Content } = await render(post);
const minutes = readingTime(post.body);
const iso = post.data.date.toISOString().slice(0, 10);
const file = post.filePath?.split('/').pop() ?? `${post.id}.mdx`;
const tags = post.data.tags ?? [];
---

<Shell
  title={post.data.title.toLowerCase()}
  description={post.data.description}
  type="article"
  current="w"
>
  <article>
    <header class="head" data-tree-avoid>
      <a class="back micro" href="/lab/signal">
        <span class="key" aria-hidden="true">←</span>
        back
      </a>
      <p class="kicker micro">writing</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      <dl class="spec module">
        <div>
          <dt class="micro">date</dt>
          <dd><time datetime={iso}><Num class="v" value={dotDate(post.data.date)} /></time></dd>
        </div>
        <div>
          <dt class="micro">read</dt>
          <dd>
            <Num class="v" value={pad2(minutes)} />
            <span class="unit micro">min</span>
          </dd>
        </div>
        <div>
          <dt class="micro">tags</dt>
          <dd>{tags.length ? tags.join(' / ') : '—'}</dd>
        </div>
        <div>
          <dt class="micro">file</dt>
          <dd>{file}</dd>
        </div>
      </dl>
    </header>

    <span class="dots rule" aria-hidden="true"></span>

    <div class="prose" data-tree-avoid="soft">
      <Content />
    </div>

    <footer class="eof" data-tree-avoid>
      <div class="eof-row">
        <span class="micro">end of file</span>
        <a class="more micro" href="/lab/signal">
          <span aria-hidden="true">←</span> index
        </a>
      </div>
    </footer>
  </article>
</Shell>

<style>
  .head {
    padding-top: 88px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }

  .back:hover {
    color: var(--ink);
  }

  .back:hover .key {
    border-color: var(--signal);
    color: var(--signal);
  }

  .kicker {
    margin-top: 72px;
  }

  h1 {
    margin-top: 14px;
    color: var(--ink);
    font-size: clamp(32px, 7vw, 48px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .lead {
    max-width: 52ch;
    margin-top: 18px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
  }

  .spec {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 40px 0 0;
    border-radius: 14px;
  }

  .spec > div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
    padding: 14px 16px 14px;
  }

  .spec > div + div {
    border-left: 1px solid var(--line);
  }

  .spec dd {
    margin: 0;
    overflow: hidden;
    color: var(--ink);
    font-size: 13px;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .spec dd {
    display: flex;
    align-items: baseline;
    min-height: 22px;
  }

  .spec .num {
    font-size: 18px;
    letter-spacing: 0.04em;
  }

  .unit {
    margin-left: 4px;
    font-size: 10px;
  }

  .rule {
    margin-block: 56px 48px;
  }

  .eof {
    margin-top: 80px;
  }

  .eof-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 599px) {
    .head {
      padding-top: 56px;
    }

    .kicker {
      margin-top: 48px;
    }

    .spec {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spec > div:nth-child(3) {
      border-left: 0;
    }

    .spec > div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  /* ---------- prose ---------- */
  .prose {
    max-width: 64ch;
    color: var(--text);
    font-size: 15.5px;
    line-height: 1.8;
    overflow-wrap: break-word;
    counter-reset: h2;
  }

  .prose > :global(* + *) {
    margin-top: 1.2em;
  }

  .prose :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 2.8em;
    color: var(--ink);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    scroll-margin-top: 24px;
    counter-increment: h2;
  }

  .prose :global(h2::before) {
    content: counter(h2, decimal-leading-zero);
    font-family: var(--font-dot);
    font-variation-settings: 'ROND' 100;
    font-weight: 900;
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .prose :global(h3) {
    margin-top: 2em;
    color: var(--ink);
    font-size: 15.5px;
    font-weight: 500;
  }

  .prose :global(.heading-anchor) {
    color: var(--muted);
    font-size: 0.8em;
    opacity: 0;
    transition:
      opacity var(--ease),
      color var(--ease);
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor) {
    opacity: 1;
  }

  .prose :global(.heading-anchor:hover) {
    color: var(--signal);
  }

  .prose :global(a:not(.heading-anchor)) {
    color: var(--ink);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition:
      color var(--ease),
      text-decoration-color var(--ease);
  }

  .prose :global(a:not(.heading-anchor):hover) {
    color: var(--signal);
    text-decoration-color: currentColor;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .prose :global(ul) {
    padding-left: 0;
    list-style: none;
  }

  .prose :global(ul > li) {
    position: relative;
    padding-left: 28px;
  }

  .prose :global(ul > li::before) {
    content: '';
    position: absolute;
    top: 0.78em;
    left: 6px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink);
  }

  .prose :global(li + li) {
    margin-top: 0.6em;
  }

  .prose :global(ol) {
    padding-left: 28px;
  }

  .prose :global(blockquote) {
    padding-left: 20px;
    border-left: 1px solid var(--ink);
    color: var(--muted);
  }

  .prose :global(hr) {
    height: var(--pitch);
    border: 0;
    margin-block: 2.6em;
    background-image: radial-gradient(
      circle at center,
      var(--dot) 0 1.1px,
      transparent 1.5px
    );
    background-size: var(--pitch) var(--pitch);
    background-repeat: repeat-x;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--module);
    color: var(--ink);
    font-size: 0.88em;
  }

  .prose :global(pre) {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background-color: var(--module) !important;
    font-size: 13.5px;
    line-height: 1.65;
    overflow-x: auto;
    tab-size: 2;
  }

  .prose :global(pre code) {
    font-family: inherit;
  }

  @media (prefers-color-scheme: dark) {
    .prose :global(.astro-code),
    .prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
    }
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
