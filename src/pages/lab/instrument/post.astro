---
import { getEntry, render } from 'astro:content';
import Shell from '../../../lab/instrument/Shell.astro';
import { dotDate } from '../../../lab/instrument/format';
import { formatDate } from '../../../lib/format';
import { readingTime } from '../../../lib/readingTime';
import '../../../lab/instrument/prose.css';

const post = await getEntry('writing', 'colophon');
if (!post) throw new Error('lab/instrument: colophon post not found');
const { Content } = await render(post);
const minutes = readingTime(post.body);
const iso = post.data.date.toISOString().slice(0, 10);
---

<Shell
  title={post.data.title.toLowerCase()}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
>
  <article>
    <header class="head">
      <p class="crumb" data-tree-avoid>
        <a href="/lab/instrument/">
          <span aria-hidden="true">←</span> index
        </a>
        <span class="sep" aria-hidden="true">/</span>
        <a href="/writing">writing</a>
      </p>

      <h1 data-tree-avoid>{post.data.title}</h1>
      <p class="lede" data-tree-avoid>{post.data.description}</p>

      <dl class="spec" data-tree-avoid>
        <div class="row">
          <dt>published</dt>
          <dd>
            <time datetime={iso} title={formatDate(post.data.date)}>
              {dotDate(post.data.date)}
            </time>
          </dd>
        </div>
        <div class="row">
          <dt>reading</dt>
          <dd class="tnum">{minutes} min</dd>
        </div>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="row">
            <dt>filed under</dt>
            <dd>{post.data.tags.join(', ')}</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="prose" data-tree-avoid="soft">
      <Content />
    </div>

    <footer class="end" data-tree-avoid>
      <a href="/writing">
        <span aria-hidden="true">←</span> all writing
      </a>
      <a href="#main">
        top <span aria-hidden="true">↑</span>
      </a>
    </footer>
  </article>
</Shell>

<script>
  // Wrap each Shiki block and add a small "copy" button.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-button';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'copy code to clipboard');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'failed';
      }
      btn.dataset.copied = '';
      setTimeout(() => {
        btn.textContent = 'copy';
        delete btn.dataset.copied;
      }, 1600);
    });
    wrap.append(btn);
  }
</script>

<style>
  .head {
    padding-top: clamp(56px, 10vh, 104px);
  }

  .crumb {
    display: flex;
    gap: 10px;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .crumb a {
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--ink);
  }

  .sep {
    color: var(--rule-strong);
  }

  h1 {
    margin-top: 40px;
    color: var(--ink);
    font-size: 34px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .lede {
    max-width: 44ch;
    margin-top: 18px;
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .spec {
    margin-top: 40px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--rule);
  }

  .prose {
    max-width: none;
    margin-top: 56px;
    margin-left: calc(var(--rail) + 24px);
  }

  .end {
    display: flex;
    justify-content: space-between;
    margin-top: 72px;
    margin-left: calc(var(--rail) + 24px);
    font-size: var(--fs-sm);
  }

  .end a {
    color: var(--muted);
    text-decoration: none;
  }

  .end a:hover {
    color: var(--ink);
  }

  @media (max-width: 639px) {
    h1 {
      font-size: 28px;
    }

    .prose,
    .end {
      margin-left: 0;
    }
  }
</style>
