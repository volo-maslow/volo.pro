---
import { getEntry, render } from 'astro:content';
import Shell from '../../../lab/apothecary/Shell.astro';
import { formatDate, isoDate } from '../../../lib/format';
import { readingTime } from '../../../lib/readingTime';

const post = await getEntry('writing', 'colophon');
if (!post) throw new Error('colophon post not found');
const { Content } = await render(post);
const minutes = readingTime(post.body);
const tags = post.data.tags ?? [];
---

<Shell
  title={post.data.title.toLowerCase()}
  description={post.data.description}
  crumbs={[{ label: 'writing', href: '/writing' }, { label: post.id }]}
  quietTree
>
  <article>
    <header class="head">
      <p class="back" data-tree-avoid>
        <a href="/lab/apothecary/"><span aria-hidden="true">← </span>index</a>
      </p>
      <h1 data-tree-avoid>{post.data.title}</h1>
      <p class="lede" data-tree-avoid>{post.data.description}</p>

      <dl class="ap-spec details" data-tree-avoid>
        <div>
          <dt>published</dt>
          <dd>
            <time datetime={isoDate(post.data.date)}>
              {formatDate(post.data.date).toLowerCase()}
            </time>
          </dd>
        </div>
        <div>
          <dt>reading time</dt>
          <dd class="tabular">{minutes} {minutes === 1 ? 'minute' : 'minutes'}</dd>
        </div>
        {tags.length > 0 && (
          <div>
            <dt>filed under</dt>
            <dd>{tags.join(', ')}</dd>
          </div>
        )}
        {post.data.draft && (
          <div>
            <dt>status</dt>
            <dd>draft</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="ap-prose" data-tree-avoid="soft">
      <Content />
    </div>

    <footer class="end" data-tree-avoid>
      <span class="lead ap-dots" aria-hidden="true"></span>
      <p>
        <a href="/lab/apothecary/"><span aria-hidden="true">← </span>return to index</a>
        <a href="#main">top <span aria-hidden="true">↑</span></a>
      </p>
    </footer>
  </article>
</Shell>

<style>
  .head {
    padding-top: 104px;
  }

  @media (max-width: 639px) {
    .head {
      padding-top: 72px;
    }
  }

  .back {
    margin-bottom: 40px;
    font-size: var(--small);
  }

  .back a {
    color: var(--muted);
  }

  .back a:hover {
    color: var(--accent);
  }

  h1 {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 72px);
    font-weight: 300;
    font-optical-sizing: auto;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    max-width: 46ch;
    margin-top: 20px;
    color: var(--muted);
    font-style: italic;
  }

  .details {
    margin-top: 56px;
    margin-bottom: 72px;
    font-size: var(--small);
  }

  .details dt,
  .details dd {
    padding-block: 8px 9px;
  }

  .end {
    margin-top: 88px;
    font-size: var(--small);
  }

  .end .lead {
    display: block;
  }

  .end p {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    color: var(--muted);
  }

  .end a:hover {
    color: var(--accent);
  }

  /* ---------- article body: mono, numbered sections ---------- */

  .ap-prose {
    max-width: 64ch;
    color: var(--text);
    overflow-wrap: break-word;
    counter-reset: ap-h2;
  }

  .ap-prose > :global(* + *) {
    margin-top: 1.3em;
  }

  .ap-prose :global(h2),
  .ap-prose :global(h3) {
    position: relative;
    color: var(--ink);
    font-size: var(--body);
    font-weight: 500;
    line-height: 1.5;
    scroll-margin-top: 32px;
  }

  .ap-prose :global(h2) {
    margin-top: 3.2em;
    margin-bottom: -0.2em;
    counter-increment: ap-h2;
  }

  .ap-prose :global(h2::before) {
    content: counter(ap-h2, decimal-leading-zero);
    margin-right: 2ch;
    color: var(--accent);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .ap-prose :global(h3) {
    margin-top: 2.4em;
  }

  .ap-prose :global(.heading-anchor) {
    margin-left: 1ch;
    color: var(--muted);
    opacity: 0;
    transition: opacity var(--ease);
  }

  .ap-prose :global(h2:hover .heading-anchor),
  .ap-prose :global(h3:hover .heading-anchor) {
    opacity: 1;
  }

  .ap-prose :global(a:not(.heading-anchor)) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--dot);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition:
      color var(--ease),
      text-decoration-color var(--ease);
  }

  .ap-prose :global(a:not(.heading-anchor):hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .ap-prose :global(strong) {
    color: var(--ink);
    font-weight: 500;
  }

  .ap-prose :global(em) {
    font-style: italic;
  }

  .ap-prose :global(ul),
  .ap-prose :global(ol) {
    padding-left: 3ch;
  }

  .ap-prose :global(ul) {
    list-style: none;
  }

  .ap-prose :global(ul > li) {
    position: relative;
  }

  .ap-prose :global(ul > li::before) {
    content: '·';
    position: absolute;
    left: -2.5ch;
    color: var(--accent);
  }

  .ap-prose :global(ol > li::marker) {
    color: var(--muted);
  }

  .ap-prose :global(li + li) {
    margin-top: 0.6em;
  }

  .ap-prose :global(blockquote) {
    padding-left: 2ch;
    border-left: 1px solid var(--accent);
    color: var(--muted);
    font-style: italic;
  }

  .ap-prose :global(hr) {
    height: 3px;
    border: 0;
    margin-block: 2.8em;
    background-image: radial-gradient(
      circle at 1.5px 1.5px,
      var(--dot) 0.85px,
      transparent 1.15px
    );
    background-size: 6px 3px;
    background-repeat: repeat-x;
  }

  .ap-prose :global(:not(pre) > code) {
    padding: 0.1em 0.4em;
    background: var(--paper-2);
    color: var(--ink);
    font-size: 0.94em;
  }

  .ap-prose :global(pre) {
    padding: 16px 18px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background-color: var(--paper-2) !important;
    font-size: 13px;
    line-height: 1.65;
    overflow-x: auto;
    tab-size: 2;
  }

  .ap-prose :global(pre code) {
    font-family: inherit;
  }

  @media (prefers-color-scheme: dark) {
    .ap-prose :global(.astro-code),
    .ap-prose :global(.astro-code span) {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
    }
  }

  .ap-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--small);
    font-variant-numeric: tabular-nums;
    display: block;
    overflow-x: auto;
  }

  .ap-prose :global(th),
  .ap-prose :global(td) {
    padding: 8px 16px 8px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .ap-prose :global(th) {
    color: var(--muted);
    font-weight: 400;
  }
</style>
