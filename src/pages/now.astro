---
import Base from '../layouts/Base.astro';
import '../styles/prose.css';
import { formatDate, isoDate } from '../lib/format';

// TODO verify: placeholder content, update when it changes.
const updated = new Date('2026-11-05');
---

<Base title="now" description="what volo maslow is doing now.">
  <header class="intro" data-tree-avoid>
    <h1>
      <span class="accent" aria-hidden="true">
        *
      </span>{' '}
      now
    </h1>
    <p class="muted">
      what i'm doing now. updated{' '}
      <time datetime={isoDate(updated)}>{formatDate(updated)}</time>.
    </p>
  </header>
  <div class="prose" data-tree-avoid="soft">
    <ul>
      <li>engineering at uptain in hamburg.</li>
      <li>
        building <a href="https://arctype.ai">arctype</a>, a calm voice and text
        journal.
      </li>
      <li>putting this site together and writing down how things work.</li>
    </ul>
    <p class="muted">
      a <a href="https://nownownow.com/about">now page</a>. if you're building
      something and want a hands-on engineer,{' '}
      <a href="mailto:hello@volo.pro">write to me</a>.
    </p>
  </div>
</Base>

<style>
  .intro {
    margin-bottom: 32px;
  }

  h1 {
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.4;
  }

  h1 .accent {
    margin-right: 0.4ch;
  }

  .intro p {
    margin-top: 8px;
  }
</style>
