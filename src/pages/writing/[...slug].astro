---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/posts';
import { formatDate, isoDate } from '../../lib/format';
import { readingTime } from '../../lib/readingTime';
import '../../styles/prose.css';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const tags = post.data.tags ?? [];
---

<Base
  title={post.data.title.toLowerCase()}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  noindex={post.data.draft}
  crumbs={[{ label: 'writing', href: '/writing' }, { label: post.id }]}
>
  <article>
    <header class="head">
      <p class="back" data-scene-avoid>
        <a href="/writing"><span aria-hidden="true">← </span>writing</a>
      </p>
      <h1 data-scene-avoid>{post.data.title}</h1>
      <p class="lede" data-scene-avoid>{post.data.description}</p>

      <dl class="spec spec--compact details" data-scene-avoid>
        <div>
          <dt>published</dt>
          <dd>
            <time datetime={isoDate(post.data.date)}>
              {formatDate(post.data.date).toLowerCase()}
            </time>
          </dd>
        </div>
        <div>
          <dt>reading time</dt>
          <dd class="tabular">
            {minutes} {minutes === 1 ? 'minute' : 'minutes'}
          </dd>
        </div>
        {tags.length > 0 && (
          <div>
            <dt>filed under</dt>
            <dd>{tags.join(', ')}</dd>
          </div>
        )}
        {post.data.draft && (
          <div>
            <dt>status</dt>
            <dd>draft</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="prose" data-scene-avoid="soft">
      <Content />
    </div>

    <footer class="end" data-scene-avoid>
      <span class="lead dots" aria-hidden="true"></span>
      <p>
        <a href="/writing"><span aria-hidden="true">← </span>all writing</a>
        <a href="#main">top <span aria-hidden="true">↑</span></a>
      </p>
    </footer>
  </article>
</Base>

<script>
  // Wrap each Shiki block and add a small "copy" button.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.replaceWith(wrap);
    wrap.append(pre);
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-button';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'copy code to clipboard');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'failed';
      }
      btn.dataset.copied = '';
      setTimeout(() => {
        btn.textContent = 'copy';
        delete btn.dataset.copied;
      }, 1600);
    });
    wrap.append(btn);
  }
</script>

<style>
  .head {
    padding-top: 104px;
  }

  @media (max-width: 639px) {
    .head {
      padding-top: 72px;
    }
  }

  .back {
    margin-bottom: 40px;
    font-size: var(--small);
  }

  .back a {
    color: var(--muted);
  }

  .back a:hover {
    color: var(--accent);
  }

  h1 {
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(44px, 7vw, 72px);
    font-weight: 300;
    font-optical-sizing: auto;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    max-width: 46ch;
    margin-top: 20px;
    color: var(--muted);
    font-style: italic;
  }

  .details {
    margin-top: 56px;
    margin-bottom: 72px;
  }

  .end {
    margin-top: 88px;
    font-size: var(--small);
  }

  .end .lead {
    display: block;
  }

  .end p {
    display: flex;
    justify-content: space-between;
    margin-top: 18px;
    color: var(--muted);
  }

  .end a:hover {
    color: var(--accent);
  }
</style>
